# Copie este arquivo para .env.local e gere uma chave própria.
# No PowerShell, uma forma simples de gerar uma chave aleatória:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
AUTH_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Banco Postgres (ex.: Prisma Postgres / Vercel Postgres / Neon / Supabase).
# Precisa ser uma connection string padrão (postgresql://usuario:senha@host:porta/banco),
# não a URL "Accelerate" (prisma+postgres://) de algumas integrações.
DATABASE_URL=

# Armazenamento de anexos (Vercel Blob). Necessário na Vercel (sem disco persistente).
BLOB_READ_WRITE_TOKEN=
