# Copie este arquivo para .env.local e gere uma chave própria.
# No PowerShell, uma forma simples de gerar uma chave aleatória:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
AUTH_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Banco remoto (Turso). Deixe em branco para usar um arquivo SQLite local (dev).
# Preenchidas, o app conecta no Turso em vez do arquivo local — necessário na Vercel,
# já que ela não tem disco persistente.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Armazenamento de anexos (Vercel Blob). Deixe em branco para salvar em
# public/uploads (só funciona em desenvolvimento local ou hospedagens com disco
# persistente, como o Railway). Necessário na Vercel.
BLOB_READ_WRITE_TOKEN=
